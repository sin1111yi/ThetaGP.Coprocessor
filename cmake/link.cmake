# The codec of Link.proto — the schema the two boards speak — is generated at
# configure time from the schema checkout and the nanopb one, into a directory
# this build compiles and git ignores. It needs protoc, the nanopb generator
# and a python-protobuf runtime; a failure stops the configure rather than
# compiling a stale or absent codec.

function(thetagp_link_codec schema_dir nanopb_dir out_dir)
  find_program(THETAGP_PYTHON3 NAMES python3 python)
  if(NOT THETAGP_PYTHON3)
    message(FATAL_ERROR
        "The link codec is generated by ${schema_dir}/generate.py, which needs "
        "python3, and none was found.")
  endif()

  set(generator "${schema_dir}/generate.py")
  if(NOT EXISTS "${generator}")
    message(FATAL_ERROR
        "${generator} is not there: lib/ThetaGP.PB is the schema checkout this "
        "firmware speaks, and the codec is generated from it.")
  endif()

  set(argv "${THETAGP_PYTHON3}" "${generator}" c
           --schema "protocol/Link.proto"
           --nanopb "${nanopb_dir}"
           --out "${out_dir}")
  if(DEFINED ENV{PROTOBUF_PYTHONPATH} AND NOT "$ENV{PROTOBUF_PYTHONPATH}" STREQUAL "")
    list(APPEND argv --protobuf-path "$ENV{PROTOBUF_PYTHONPATH}")
  endif()

  message(STATUS "link codec: generating ${out_dir}/Link.pb.c ...")
  execute_process(COMMAND ${argv}
                  RESULT_VARIABLE link_result
                  OUTPUT_VARIABLE link_output
                  ERROR_VARIABLE link_error)
  if(NOT link_result EQUAL 0)
    message(FATAL_ERROR
        "Generating the link codec failed: ${generator} exited "
        "${link_result}.\n${link_output}\n${link_error}\n"
        "It needs protoc on PATH, the nanopb checkout in ${nanopb_dir}, and a "
        "python-protobuf runtime — install one, or point $PROTOBUF_PYTHONPATH "
        "at a site-packages directory that holds google/protobuf.")
  endif()

  foreach(pair "Link.pb.c" "Link.pb.h")
    if(NOT EXISTS "${out_dir}/${pair}")
      message(FATAL_ERROR
          "${generator} exited 0 but ${out_dir}/${pair} is not there.")
    endif()
  endforeach()
endfunction()
